{
  "expo": {
    "name": "AlfaScan",
    "slug": "alfascan",
    "version": "1.3.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "imageWidth": 420,
      "resizeMode": "cover",
      "backgroundColor": "#0F1720",
      "dark": {
        "image": "./assets/splashDark.png",
        "imageWidth": 420,
        "resizeMode": "cover",
        "backgroundColor": "#0F1720"
      }
    },
    "updates": {
      "enabled": false,
      "url": "https://u.expo.dev/b5ec4137-fc07-486f-8f4d-c43341bd9038"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "runtimeVersion": "1.0.1"
    },
    "android": {
      "runtimeVersion": "1.0.1",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.alfagestion.alfascan"
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "1449bcd3-b8db-4693-a147-a2e3774bed9c"
      }
    },
    "owner": "alfaapp",
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-build-properties",
      "expo-sqlite"
    ]
  }
}
