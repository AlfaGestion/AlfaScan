{
  "cli": {
    "version": ">= 1.0.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "android": {
        "gradleCommand": ":app:assembleDebug",
        "env": { "JAVA_HOME": "/usr/lib/jvm/java-17-openjdk-amd64" }
      },
      "ios": { "buildConfiguration": "Debug" }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease",
        "env": { "JAVA_HOME": "/usr/lib/jvm/java-17-openjdk-amd64" }
      }
    },
    "apk": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease",
        "env": { "JAVA_HOME": "/usr/lib/jvm/java-17-openjdk-amd64" }
      }
    },
    "production": {
      "android": {
        "env": { "JAVA_HOME": "/usr/lib/jvm/java-17-openjdk-amd64" }
      }
    }
  },
  "submit": { "production": {} }
}
